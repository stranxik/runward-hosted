# The configuration of runward hosted (src/main.js#readConfig). Names only: no value here is a secret, and
# no secret is ever written in a file. In production the secret ones are secret environment variables of
# the container, set from the keychain by API. A missing or unsafe setting stops the start (exit 78).
NODE_ENV=production
RW_ORIGIN=https://app.runward.dev
# Local witness only (refused in production): RW_STORE=memory
RW_STORE=postgres
# secret: role rw_app, on the private network
DATABASE_URL=
# verify-full (default) or disable (refused in production off the loopback interface)
DATABASE_SSL=verify-full
# The database instance's certificate (public), as PEM, or a path to it
DATABASE_CA=
DATABASE_CA_FILE=
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=
# secret: the service's own object storage key, never the provisioning key
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The published commits of send.yml that uploads may come from, comma separated
RW_SEND_WORKFLOW_SHAS=
RW_SEND_WORKFLOW_REVOKED=
# The number of the hoster's proxies in front of the service (0: none). The rate limits count the
# X-Forwarded-For entry the outermost trusted proxy appended; check it on the first deployment.
RW_TRUST_PROXY=1
RW_EXTRA_HOSTS=
RW_COMMIT=
RW_IMAGE=
RW_READER_REPOSITORY_ID=
RW_SECURITY_CONTACT=
PORT=8080
